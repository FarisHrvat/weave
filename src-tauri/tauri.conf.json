{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weave",
  "version": "0.1.0",
  "identifier": "app.weave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Weave",
        "visible": false,
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "backgroundColor": "#151820"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*; font-src 'self' data:; frame-src data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Faris Hrvat",
    "copyright": "Copyright 2026 Faris Hrvat. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Git, files and terminals in one workspace",
    "longDescription": "Weave is a desktop workspace for Git, file transfers (SFTP, FTP, WebDAV, S3, Azure and cloud drives) and terminals (SSH, Telnet, serial, Mosh). It keeps your data on your own computer.",
    "homepage": "https://farishrvat.github.io/weave/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["openssh-client", "git"]
      },
      "rpm": {
        "depends": ["openssh-clients", "git"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
